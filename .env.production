# Production Environment Variables Template
# DO NOT commit actual values - set these in your deployment platform

# Backend (Railway/Render)
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_super_secret_production_key_at_least_32_chars
NODE_ENV=production

# Frontend will be deployed separately on Vercel
# Update VITE_API_URL in frontend build settings to point to your backend URL
